{
  "name": "about-my-pet-api-typescript",
  "version": "1.0.0",
  "description": "Api de um sistema pra gerenciamento de animais domésticos",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "dev": "node --env-file=.env.development ./node_modules/.bin/ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "start": "node --env-file=.env.production -r ./node_modules/.bin/ts-node-dev --respawn --transpile-only src/index.ts",
    "prod": "npm && npm run build && node -r ts-node/register/transpile-only -r tsconfig-paths/register ./build/index.js",
    "typeorm": "NODE_OPTIONS='-r tsconfig-paths/register' typeorm-ts-node-commonjs -d ./src/database/dataSource.ts",
    "migration:generate": "npm run typeorm migration:generate ./src/database/migrations/default && eslint --fix ./**/migrations/*.{js,ts}",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "doc:generate": "tsoa spec",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"./**/*.{ts,js,css,md,json}\" --config ./.prettierrc",
    "before:build": "npm run lint:fix && npm run format && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adryfernandes/about-my-pet-api-typescript.git"
  },
  "author": "Adryane Fernandes",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/adryfernandes/about-my-pet-api-typescript/issues"
  },
  "homepage": "https://github.com/adryfernandes/about-my-pet-api-typescript#readme",
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "about-my-pet-db-postgres": "github:adryfernandes/about-my-pet-db-postgres",
    "axios": "1.18.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "cpf_cnpj": "0.2.0",
    "dayjs": "1.11.21",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "prisma": "7.8.0",
    "swagger-ui-express": "5.0.1",
    "ts-retry": "7.0.3",
    "tsoa": "6.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "26.0.0",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-love": "^154.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "^17.6.0",
    "prettier": "3.8.4",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "6.0.3"
  }
}
